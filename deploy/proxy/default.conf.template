# Proxy inverso de Faro: TLS, cabeceras de seguridad y límite de peticiones.
#
# El contenedor oficial procesa esta plantilla con envsubst al arrancar y solo
# sustituye las variables de entorno definidas (DOMAIN, PUBLIC_URL); las
# variables propias de Nginx ($host, $uri…) quedan intactas.
# Escucha en 8080/8443 porque corre sin privilegios; Compose publica 80/443.

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=10r/s;
limit_req_status 429;
server_tokens off;
client_max_body_size 16k;

upstream faro_web { server web:8080; keepalive 8; }
upstream faro_api { server api:3000; keepalive 16; }

# --- HTTP: healthcheck interno, reto ACME y redirección a HTTPS ---------------
server {
    listen 8080 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Cualquier otro Host se descarta sin respuesta (444): evita ataques con Host falso.
    location / { return 444; }
}

server {
    listen 8080;
    server_name ${DOMAIN};

    # Validación HTTP-01 de Let's Encrypt (solo se usa con `make letsencrypt`).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / { return 301 ${PUBLIC_URL}$request_uri; }
}

# --- HTTPS: rechaza conexiones cuyo SNI no sea nuestro dominio -----------------
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Cabeceras de seguridad. `always` las incluye también en respuestas de error.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;

    # La API (Helmet) y este proxy fijan las mismas cabeceras: se descartan las
    # del upstream para no enviarlas duplicadas.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Content-Security-Policy;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Este proxy es el borde: se sobrescribe X-Forwarded-For en lugar de
    # ampliarlo, así un cliente no puede falsificar su IP de origen.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;

    location /api/ {
        limit_req zone=api_zone burst=30 nodelay;
        proxy_pass http://faro_api;
    }

    # Las métricas y la salud de la API son internas: nunca salen por el proxy.
    location ~ ^/(metrics|health)(/|$) { return 404; }

    location / {
        proxy_pass http://faro_web;
    }
}
