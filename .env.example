# Copia este archivo a .env (lo hace `make init`) y ajusta lo que necesites.

# Dominio con el que se publica el sitio. `faro.localhost` resuelve a 127.0.0.1
# en navegadores modernos; en producción pon tu dominio real.
DOMAIN=faro.localhost
# URL pública completa (incluye el puerto si no es 443). Se usa en la redirección HTTP→HTTPS.
PUBLIC_URL=https://faro.localhost

# Puertos del host. Cámbialos (p. ej. 8080 y 8443) si 80/443 están ocupados.
HTTP_PORT=80
HTTPS_PORT=443

TZ=America/Bogota

# VPN WireGuard: dirección pública del servidor (o `auto`), puerto UDP y clientes.
WG_SERVERURL=auto
WG_PORT=51820
WG_PEERS=laptop,celular

# Correo para Let's Encrypt (solo con `make letsencrypt-issue`).
LETSENCRYPT_EMAIL=
